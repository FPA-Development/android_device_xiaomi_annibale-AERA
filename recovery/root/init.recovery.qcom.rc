import /init.recovery.prepdecrypt.rc
import /init.recovery.wifi.rc
import /init.recovery.cellular.rc

# Release temporary stock /vendor and /odm overlays as soon as module loading
# finishes so all recovery HALs execute from the recovery ramdisk instead of
# the installed ROM's /vendor partition (which would pin /vendor busy and crash
# crypto HALs).
service aera-restore-ramdisk /system/bin/sh -c "while grep -q '^/dev/block/.* /odm ' /proc/mounts; do umount -l /odm || exit 1; done; while grep -q '^/dev/block/.* /vendor ' /proc/mounts; do umount -l /vendor || exit 1; done; echo 'AERA: early vendor/odm overlay cleanup complete' > /dev/kmsg; setprop aera.ramdisk.ready 1"
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0

on early-init
    wait /sys/fs/selinux/enforce
    write /sys/fs/selinux/enforce 0

on early-fs
    write /proc/sys/walt/sched_lib_name "recovery,magiskboot,Updater,updater,update_engine_sideload"
    write /proc/sys/walt/sched_lib_mask_force 255

on fs
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /persist 0775 root system
    mkdir /mnt/vendor 0775 shell system
    mkdir /mnt/vendor/persist 0775 shell system
    wait /dev/block/bootdevice/by-name/persist 5
    mount ext4 /dev/block/bootdevice/by-name/persist /persist noatime nosuid nodev barrier=1
    mount none /persist /mnt/vendor/persist bind
    install_keyring

on init
    start vendor.boot-qti
    setprop prepdecrypt.setpatch true

on boot
    setprop sys.usb.config adb

on property:twrp.modules.loaded=true
    # Unmount temporary stock /vendor & /odm before starting any vendor HAL.
    start aera-restore-ramdisk

on property:aera.ramdisk.ready=1
    # Ensure SSD partition node is ready for qseecomd's SSD listener.
    wait /dev/block/bootdevice/by-name/ssd 10
    start vendor.qseecomd
    # Mount modem firmware outside /vendor so packaged eSE trustlets in
    # /vendor/firmware_mnt stay intact.
    mkdir /firmware 0755 root shell
    mount vfat /dev/block/bootdevice/by-name/modem${ro.boot.slot_suffix} /firmware ro shortname=lower,uid=1000,gid=1000,dmask=227,fmask=337
    # Prepare OS/SPL version properties and link remaining modem firmware.
    start prepdecrypt.vendor
    # Load ADSP firmware for PMIC and USB-OTG.
    wait /sys/kernel/boot_adsp/boot 5
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/kernel/boot_adsp/ssr 2
    write /sys/kernel/boot_adsp/ssr 1
    wait /sys/class/power_supply/battery 2
    start vibratorfeature-hal-service

on property:crypto.ready=1 && property:aera.ramdisk.ready=1
    # Start after prepdecrypt finishes restoring /vendor so neither Keymaster_Ver
    # nor module loading can overlay /vendor with ENOENT.
    start vendor.health-recovery
    start touch_report

on property:vendor.sys.listeners.registered=true && property:aera.ramdisk.ready=1
    start vendor.ssgtzd
    start vendor.gatekeeper_default

# Start eSE, Weaver, KeyMint TEE, and StrongBox only after ramdisk /vendor is
# restored, QSEE listeners are up, and prepdecrypt has updated OS/SPL props.
on property:vendor.sys.listeners.registered=true && property:crypto.ready=1 && property:aera.ramdisk.ready=1
    start vendor.secure_element
    start vendor.weaver_nxp
    start vendor.keymint-qti
    start vendor.keymint-strongbox
